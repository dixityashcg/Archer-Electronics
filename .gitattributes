# LaunchOS — engagement artifacts are identified by content hash, so their
# bytes must not change between platforms.
engagement/** text eol=lf
# Client inputs are not artifacts — nothing hashes or approves them — so a
# PDF or spreadsheet the client handed over must not be normalised as text.
engagement/inputs/** -text
# The allowed-signers file is derived from the ledger, so two operators
# registering keys concurrently generate overlapping versions of it. A union
# merge keeps both sides rather than producing this feature’s only merge
# conflict — and it grants nothing, because `launch verify` rebuilds the file
# from its events and reports any line they do not account for.
engagement/keys/allowed-signers merge=union
# Pictures, PDFs, Office files and archives are bytes, not text: the rule
# above would rewrite the CR LF pairs inside them and damage them in git.
engagement/**/*.png binary
engagement/**/*.jpg binary
engagement/**/*.jpeg binary
engagement/**/*.gif binary
engagement/**/*.webp binary
engagement/**/*.bmp binary
engagement/**/*.ico binary
engagement/**/*.pdf binary
engagement/**/*.docx binary
engagement/**/*.xlsx binary
engagement/**/*.pptx binary
engagement/**/*.zip binary
engagement/**/*.gz binary
engagement/**/*.tgz binary
engagement/**/*.mp4 binary
engagement/**/*.mov binary
engagement/**/*.webm binary
engagement/**/*.woff binary
engagement/**/*.woff2 binary
